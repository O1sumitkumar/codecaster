# Twitch (optional — bot runs in mock mode when unset)
TWITCH_USERNAME=
TWITCH_TOKEN=
TWITCH_CHANNEL=

# OpenAI (optional — agent uses mock fixtures when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Codex session (placeholder only — set your real session in local .env)
CODEX_SESSION_ID=

# Service ports
BOT_HTTP_PORT=4000
AGENT_HTTP_PORT=4001
TOY_WEB_PORT=5173
TOY_API_PORT=3000

# Agent sandbox parent directory (defaults to OS temp)
CODECASTER_SANDBOX_ROOT=
